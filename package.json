{
  "name": "ai-usage",
  "version": "0.1.0",
  "description": "Show current usage limits of your AI subscriptions (Claude, ChatGPT)",
  "private": true,
  "type": "module",
  "bin": {
    "aiu": "./src/cli.ts"
  },
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "hooks:install": "bash scripts/setup-hooks.sh",
    "hooks:doctor": "bash scripts/check-hooks.sh",
    "postinstall": "if [ -f scripts/setup-hooks.sh ]; then bash scripts/setup-hooks.sh; fi"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
